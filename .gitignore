# Python + PyTorch + Docker project ... plus dataset/model output artifacts
# ---------------------------------------------------------------------------
# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env
.env.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Notebooks (checkpoints only)
.ipynb_checkpoints/

# Model weights / ONNX artifacts are regenerable and large -- Git LFS or ignore
models/*.pth
models/*.pt
models/*.onnx
models/*.json
!models/.gitkeep

# Datasets are cached locally, never committed
data/

# Results are regenerated by training/eval; keep the directory but not contents
results/*.json
results/*.md
results/*.csv
results/*.png
!results/.gitkeep

# Docker build artifacts
.dockerignore-artifacts/
*.tar
docker-image-id.txt

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo